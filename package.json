{
  "name": "fatenava-mcp",
  "version": "0.1.2",
  "description": "MCP server for casting BaZi (Four Pillars), Zi Wei Dou Shu, and Western astrology natal charts — deterministic, free, no account required. Powered by FateNava.",
  "type": "module",
  "bin": {
    "fatenava-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README*.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bazi",
    "four-pillars",
    "ziwei",
    "zi-wei-dou-shu",
    "astrology",
    "natal-chart",
    "horoscope",
    "fortune-telling",
    "chinese-astrology",
    "fatenava"
  ],
  "author": "FateNava (https://fatenava.com?utm_source=fatenava-mcp&utm_medium=npm)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatenava/fatenava-mcp.git"
  },
  "homepage": "https://fatenava.com?utm_source=fatenava-mcp&utm_medium=npm",
  "bugs": {
    "url": "https://github.com/fatenava/fatenava-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "mcpName": "io.github.fatenava/fatenava-mcp"
}
